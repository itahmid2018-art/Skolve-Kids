# ==============================================================================
# Skolve - AI Education Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# PORT: Port where the full-stack server listens (Port 3000 required in AI Studio)
PORT=3000

# APP_URL: Public URL where the application is hosted
# In AI Studio, this is automatically injected with the Cloud Run preview URL.
APP_URL="http://localhost:3000"

# DEFAULT_AI_PROVIDER: Specify the preferred AI provider to use
# Options: "auto" (default, picks first validated available provider),
#          "gemini", "openai", "anthropic", "openrouter", "huggingface", "ollama", "llamacpp"
DEFAULT_AI_PROVIDER="auto"

# Real-time event bus heartbeat interval in milliseconds
SSE_HEARTBEAT_INTERVAL=15000

# Directory where timestamped testing error logs are deposited
TESTING_ERROR_LOG_DIR="testing/errors"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI (Default / Native in AI Studio)
# ------------------------------------------------------------------------------
# In Google AI Studio, GEMINI_API_KEY is automatically injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 3. OPENAI (Optional)
# ------------------------------------------------------------------------------
# Standard OpenAI platform (https://platform.openai.com)
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 4. ANTHROPIC CLAUDE (Optional)
# ------------------------------------------------------------------------------
# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# ------------------------------------------------------------------------------
# 5. OPENROUTER (Optional - Unified MoE & Open Weights Gateway)
# ------------------------------------------------------------------------------
# OpenRouter gives access to Qwen 2.5/3, Llama 3.3, Mistral, DeepSeek, etc. (https://openrouter.ai)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="qwen/qwen-2.5-72b-instruct"

# ------------------------------------------------------------------------------
# 6. HUGGING FACE INFERENCE (Optional)
# ------------------------------------------------------------------------------
# Hugging Face dedicated inference endpoint or Serverless Inference API (https://huggingface.co)
HUGGINGFACE_API_KEY="hf_..."
HUGGINGFACE_ENDPOINT_URL="https://router.huggingface.co/hf-inference/v1"
HUGGINGFACE_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"

# ------------------------------------------------------------------------------
# 7. OLLAMA (Optional - Local Open-Source MoE & Dense Models)
# ------------------------------------------------------------------------------
# Local Ollama daemon running on your workstation (https://ollama.com)
# Default address: http://localhost:11434 (or host.docker.internal / IP)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:32b"

# ------------------------------------------------------------------------------
# 8. LLAMA.CPP SERVER (Optional - Local / Remote GGUF Inference)
# ------------------------------------------------------------------------------
# llama.cpp HTTP server (e.g. `./llama-server -m models/qwen.gguf --port 8080`)
LLAMACPP_BASE_URL="http://localhost:8080"
LLAMACPP_MODEL="default"
LLAMACPP_API_KEY=""
